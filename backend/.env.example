# Connection string for the backend. The +psycopg driver suffix is required.
# A hosted Neon database needs its sslmode/channel_binding parameters kept:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require&channel_binding=require
# This file is gitignored: never commit a real password.
DATABASE_URL=postgresql+psycopg://lunar:local_dev_password_change_me@127.0.0.1:5432/lunar_planner
